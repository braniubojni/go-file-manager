{
  "name": "go-file-manager",
  "private": true,
  "description": "Dual-pane desktop file manager (Wails v3 + Go + React)",
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "*.go": "gofmt -w",
    "frontend/src/**/*.{ts,tsx,css,json}": "prettier --write --config frontend/.prettierrc --ignore-path frontend/.prettierignore"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.7.4"
  }
}
